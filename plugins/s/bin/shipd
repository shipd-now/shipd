#!/usr/bin/env python3
"""shipd — the single command-line front end for the shipd spec engine.

A curated dispatcher, not a passthrough: every verb below maps to one engine
script invocation under ``../skills/build/scripts/``, resolved relative to this
file's own resolved location so the binary works from a repo checkout and from
a versioned plugin cache snapshot alike. Delegation is process replacement
(:func:`os.execv`), so the delegate's stdout, stderr, interactivity, and exit
code are this binary's own — nothing is reimplemented or reformatted here.

Only read/inspect verbs are exposed, with six deliberate exceptions, each
writing user-domain files and never a spec artifact, and each only under an
explicit word: ``statusline install`` writes the statusline registration into
the user's own Claude Code settings file, ``copilot add`` / ``copilot remove``
maintain the shipd Copilot code-review skill's four files inside a target
repository, ``vendor add`` / ``vendor remove`` maintain a vendored per-repo
shipd install there, ``harness add`` / ``harness remove`` maintain the
generated ``/s:`` command files inside a repository or the user's own harness
directories, ``install`` asks which harnesses the user works in and
installs the chosen ones' commands into their home directory, and ``init``
creates the content directory's empty layout directories — never a spec
artifact, and never modifying anything already there. The mutating
verbs over the spec library (``set-status``,
``merge``, ``emit``, ``autopilot``, ``worktree remove``) stay behind their
guarded scripts and skills.

Stdlib-only Python 3, per the engine's constitution.
"""

import argparse
import importlib.util
import json
import os
import re
import shlex
import shutil
import stat
import subprocess
import sys
import sysconfig
import tempfile
from pathlib import Path

HERE = Path(__file__).resolve().parent
PLUGIN_ROOT = HERE.parent
SCRIPTS = PLUGIN_ROOT / "skills" / "build" / "scripts"
MANIFEST = PLUGIN_ROOT / ".claude-plugin" / "plugin.json"

# An applied change is archived as ``completed/<YYYY-MM-DD>-<slug>/``; the slug
# is the change's name. Mirrors the engine's own archive-directory convention
# (``metrics.py``'s ship-date walk, ``dashboard.py``'s ``completed/*-<slug>``
# resolution) rather than importing a private helper.
ARCHIVE_DIR_RE = re.compile(r"^\d{4}-\d{2}-\d{2}-(.+)$")

# The engine modules the in-binary ``list`` verb reads, imported on demand by
# :func:`_load_engine` — every other verb replaces this process before it needs
# them, so dispatch pays no import cost.
sc = None
ss = None

# The registry the in-binary ``harness`` verb reads, imported on demand by
# :func:`_load_registry` for the same reason and kept separate from the pair
# above so neither path pays for the other's import. ``hg`` is the generation
# engine behind that verb's writing actions, imported only when one runs, so
# the read actions never load the body templates' renderer.
hr = None
hg = None

# The interactive ``install`` flow, imported on demand by
# :func:`_load_install_tui` for the same reason — it pulls in the generation
# engine and the wordmark, which no other verb needs.
iu = None

# The curated verb table: verb -> (engine script, leading arguments). Trailing
# arguments from the command line are appended verbatim, so ``--root``, slugs,
# and flags keep working exactly as they do against the script itself.
VERB_TABLE = {
    "init": ("spec_status.py", ["init"]),
    "status": ("spec_status.py", ["show"]),
    "locate": ("spec_status.py", ["locate"]),
    "related": ("spec_status.py", ["related"]),
    "epic": ("spec_status.py", ["epic-show"]),
    "workspace": ("spec_status.py", ["workspace-show"]),
    "board": ("dashboard.py", ["tui"]),
    "metrics": ("metrics.py", []),
    "lint": ("spec_lint.py", []),
}

# ``board`` leads with the interactive board and exposes its other renderings
# as positional mode words: mode -> (engine script, leading arguments), with
# ``None`` the mode-less default. A mode is recognized only when it is the
# *first* trailing argument and a bare word, so ``shipd board --root X`` keeps
# the default mode and passes its flags through untouched.
BOARD_MODES = {
    None: ("dashboard.py", ["tui"]),
    "text": ("dashboard.py", ["board"]),
}

USAGE = """\
usage: shipd <verb> [args...]

Read/inspect verbs over the shipd spec engine. Trailing arguments are passed
through to the engine verbatim.

verbs:
  init [--root DIR]          create the content directory layout (safe to re-run)
  list [--root DIR] [--all]  in-flight changes across the root and its worktrees
  status [change]            a change's status and progress
  locate [change]            where an installed change lives
  related <term> [term...]   spec artifacts ranked by term-hit count
  epic <slug>                an epic's status, metadata, and member states
  workspace                  the workspace root, its projects, and initiatives
  board [text] [args]        the delivery board (default: full-screen)
  metrics [subverb]          delivery metrics (default: summary)
  lint [change]              structurally validate specs and change deltas
  doctor                     preflight this environment for shipd
  statusline [install]       report or register the shipd statusline
  copilot [add|remove]       maintain the Copilot code-review skill in a repo
  vendor [add|remove]        maintain a vendored per-repo shipd install
  harness [list|show|add|remove|status]
                             the harness registry, and the generated /s:
                             command files in a repo or in your home
  install                    pick your harnesses and install their commands
  update [--check]           report or install a newer published plugin version

options:
  -h, --help                 print this banner
  --version                  print the plugin version

The read verbs list, status, locate, related, epic, workspace, lint, and
harness accept --json, emitting one machine-readable JSON document instead of
the text report.
"""


def _err(reason):
    """Write the convention's single ``Error: <reason>`` line to stderr, red
    prefix only on a terminal with ``NO_COLOR`` unset.

    The engine's ``cli_common.err`` is the authority on this format; the guard
    is inlined here because dispatch replaces this process (:func:`os.execv`)
    before any engine import, and a path insert plus import on every invocation
    is not worth two error sites. Keep the two in step.
    """
    prefix = "Error:"
    if sys.stderr.isatty() and not os.environ.get("NO_COLOR"):
        prefix = "\x1b[31m%s\x1b[0m" % prefix
    sys.stderr.write("%s %s\n" % (prefix, reason))


def _plugin_version():
    """The version the adjacent plugin manifest declares — the shipping unit's
    own version, so a checkout copy and a cache snapshot each report what they
    actually are. Raises on an unreadable or malformed manifest; every caller
    reports that through :func:`_err`."""
    with open(MANIFEST, encoding="utf-8") as fh:
        return json.load(fh)["version"]


def cmd_version():
    """Print the plugin manifest's version."""
    try:
        version = _plugin_version()
    except (OSError, ValueError, KeyError, TypeError) as exc:
        _err("cannot read %s: %s" % (MANIFEST, exc))
        return 1
    print(version)
    return 0


def _load_engine():
    """Import ``spec_common`` and ``spec_status`` from the engine's scripts dir
    into the module globals ``sc``/``ss``. Deferred to the ``list`` path so a
    delegating verb never pays for it."""
    global sc, ss
    if str(SCRIPTS) not in sys.path:
        sys.path.insert(0, str(SCRIPTS))
    import spec_common
    import spec_status
    sc = spec_common
    ss = spec_status


def _load_registry():
    """Import ``harness_registry`` from the engine's scripts dir into the
    module global ``hr``. Deferred to the ``harness`` path, exactly as
    :func:`_load_engine` is to ``list``."""
    global hr
    if str(SCRIPTS) not in sys.path:
        sys.path.insert(0, str(SCRIPTS))
    import harness_registry
    hr = harness_registry


def _load_generate():
    """Import ``harness_generate`` into the module global ``hg``. Deferred to
    the ``harness`` verb's writing actions, so ``list`` and ``show`` stay as
    cheap — and as free of the body templates — as they were."""
    global hg
    if str(SCRIPTS) not in sys.path:
        sys.path.insert(0, str(SCRIPTS))
    import harness_generate
    hg = harness_generate


def _load_install_tui():
    """Import ``install_tui`` into the module global ``iu``. Deferred to the
    ``install`` verb, which is the only caller of the interactive flow."""
    global iu
    if str(SCRIPTS) not in sys.path:
        sys.path.insert(0, str(SCRIPTS))
    import install_tui
    iu = install_tui


def _content_dir(root):
    """``root``'s content directory as its layered config resolves it, or
    ``None`` when that config is unusable — a foreign directory under
    ``.worktrees/`` must never fail the listing."""
    try:
        return sc.specs_dir(root)
    except sc.ConfigError:
        return None


def _subdirs(path):
    """Sorted directory entries under ``path`` that are themselves
    directories; empty when ``path`` is missing or unreadable."""
    try:
        names = sorted(os.listdir(path))
    except OSError:
        return []
    return [n for n in names if os.path.isdir(os.path.join(path, n))]


def _planned_rows(root, location):
    """``(name, location, status)`` for every change under ``root``'s
    ``planned/``, status read by the engine (``?`` when missing or invalid,
    as ``spec_status.py locate`` prints it)."""
    content = _content_dir(root)
    if content is None:
        return []
    return [(name, location, ss.read_status(root, name) or "?")
            for name in _subdirs(os.path.join(content, "planned"))]


def _archived_rows(root, location):
    """``(name, location, "archived")`` for every applied change under
    ``root``'s ``completed/``, named by the archive directory's slug."""
    content = _content_dir(root)
    if content is None:
        return []
    rows = []
    for name in _subdirs(os.path.join(content, "completed")):
        m = ARCHIVE_DIR_RE.match(name)
        rows.append((m.group(1) if m else name, location, "archived"))
    return rows


def _probes(root):
    """``(directory, location-label)`` pairs to probe, the invocation root
    first and then each ``.worktrees/<name>`` in sorted order — the probe
    order and precedence of ``spec_status.py locate``."""
    probes = [(root, "root")]
    worktrees = os.path.join(root, ".worktrees")
    for name in _subdirs(worktrees):
        probes.append((os.path.join(worktrees, name), "worktree:" + name))
    return probes


def _collect(root, reader):
    """Apply ``reader`` over every probe, keyed by change name. Probes run
    root-first, so a worktree occurrence wins a contested name."""
    found = {}
    for candidate, location in _probes(root):
        for row in reader(candidate, location):
            found[row[0]] = row
    return found


def cmd_list(args):
    """List in-flight changes across the invocation root and its worktrees."""
    parser = argparse.ArgumentParser(
        prog="shipd list",
        description="In-flight changes across the root and its worktrees.")
    parser.add_argument("--root", default=os.getcwd(),
                        help="repository root (default: cwd)")
    parser.add_argument("--all", action="store_true",
                        help="also list applied changes from completed/")
    parser.add_argument("--json", action="store_true", dest="json",
                        help="emit the rows as a JSON array on stdout")
    opts = parser.parse_args(args)
    root = os.path.abspath(opts.root)
    _load_engine()

    in_flight = _collect(root, _planned_rows)
    rows = [in_flight[name] for name in sorted(in_flight)]
    if opts.all:
        # Appended after the in-flight rows; a name still in flight keeps its
        # live row rather than an older archive of the same change.
        archived = _collect(root, _archived_rows)
        rows.extend(archived[name] for name in sorted(archived)
                    if name not in in_flight)

    # The machine rendering of the very same rows, in the very same order — an
    # empty listing is an empty array, never the text placeholder (shipd-cli
    # list-json).
    if opts.json:
        print(json.dumps([{"name": name, "location": location,
                           "status": status}
                          for name, location, status in rows]))
        return 0

    if not rows:
        print("no changes in flight")
        return 0
    name_width = max(len(row[0]) for row in rows)
    location_width = max(len(row[1]) for row in rows)
    for name, location, status in rows:
        print("%-*s  %-*s  %s"
              % (name_width, name, location_width, location, status))
    return 0


# ---------------------------------------------------------------------------
# doctor (shipd-cli doctor-verb)
# ---------------------------------------------------------------------------

# The interpreter floor: the engine is stdlib-only Python 3 and the pinned
# ``textual`` supports 3.9+, so 3.9 is the oldest interpreter the whole surface
# runs on.
PYTHON_FLOOR = (3, 9)

# A plugin cache snapshot lives at ``<cache>/<marketplace>/<plugin>/<version>/``
# — a directory named for a dotted release. A checkout's ``plugins/s`` never is.
VERSION_DIR_RE = re.compile(r"^\d+(?:\.\d+)*$")


def _version_key(name):
    """A dotted version's comparison key, so ``0.6.10`` sorts above ``0.6.9``
    where a plain string sort would not."""
    return tuple(int(part) for part in name.split("."))


def _gh_auth_status():
    """The exit code of ``gh auth status``; nonzero when gh cannot be run at
    all. One of the two subprocess seams in the doctor path — the other is
    :func:`_gh_run`, which the GitHub-side checks probe through — isolated here
    so tests inject a stub instead of touching the network. Bounded by
    :data:`GH_TIMEOUT` like the other seam, so a hung ``gh`` reads as
    unusable rather than stalling the preflight."""
    try:
        return subprocess.run(["gh", "auth", "status"], capture_output=True,
                              timeout=GH_TIMEOUT).returncode
    except (OSError, subprocess.TimeoutExpired):
        return 1


def check_python(version_info=None):
    """The running interpreter — the one the engine itself runs on."""
    info = tuple((version_info or sys.version_info)[:3])
    shown = ".".join(str(part) for part in info)
    floor = ".".join(str(part) for part in PYTHON_FLOOR)
    if info >= PYTHON_FLOOR:
        return ("ok", "python", "%s (>= %s)" % (shown, floor))
    return ("fail", "python",
            "%s is below the required %s — run shipd on a newer Python 3"
            % (shown, floor))


def check_git(which=shutil.which):
    """git — every worktree, branch, and PR in the workflow needs it."""
    found = which("git")
    if found:
        return ("ok", "git", "found at %s" % found)
    return ("fail", "git",
            "not on PATH — install git (https://git-scm.com/downloads); "
            "worktrees, branches, and shipping all need it")


def check_config(root):
    """The layered content-directory configuration at ``root``. A missing
    content directory is fine — ``/s:plan`` scaffolds it on first use; only an
    unusable config file is a failure.

    The layered config's ``pr-mode`` key is validated here too (shipd-cli
    doctor-pr-mode-check spec) rather than under a check name of its own: an
    invalid *declared* value fails this check carrying the accessor's own
    error line, which already names the key, the offending value, the
    accepted values, and the config file that supplied it. A valid or
    undeclared key leaves the reporting below untouched."""
    _load_engine()
    try:
        content = sc.specs_dir(root)
        sc.resolve_pr_mode(root)
    except sc.ConfigError as exc:
        return ("fail", "config", "%s" % exc)
    if os.path.isdir(content):
        return ("ok", "config", "content directory %s" % content)
    return ("ok", "config",
            "no content directory yet at %s — /s:plan scaffolds it" % content)


def check_pipeline(root, resolve=None):
    """The effective autonomous pipeline at ``root``, through the engine's own
    resolver. A declared pipeline that cannot resolve — malformed entries, an
    unknown preset, or pydantic missing — is a hard stop for the delivery
    surfaces that run it, so it fails the preflight carrying the resolver's own
    error line. ``resolve`` is the injection point; it defaults to the real
    resolver once the engine is loaded."""
    _load_engine()
    resolve = resolve or sc.resolve_pipeline
    try:
        entries, provenance = resolve(root)
    except sc.ConfigError as exc:
        return ("fail", "pipeline", "%s" % exc)
    return ("ok", "pipeline",
            "resolves: %d entries (source: %s)" % (len(entries), provenance))


def check_gh(which=shutil.which, gh_status=_gh_auth_status):
    """The GitHub CLI. A warning, never a failure: planning and building work
    without it, and shipping is its first touchpoint."""
    found = which("gh")
    if not found:
        return ("warn", "gh",
                "not on PATH — needed only to ship (https://cli.github.com)")
    if gh_status() != 0:
        return ("warn", "gh",
                "%s is not authenticated — run `gh auth login` before shipping"
                % found)
    return ("ok", "gh", "authenticated at %s" % found)


def check_difft(which=shutil.which):
    """Difftastic, the semantic review's syntax-aware diff engine. Recommended,
    never required: without it a review still completes, on the structural-text
    engine, so its absence is a warning that names that degradation and the
    tiered installer that repairs it."""
    found = which("difft")
    if not found:
        return ("warn", "difft",
                "not found — semantic reviews degrade to the text engine; "
                "run /s:doctor or `semdiff doctor --fix` to install it")
    return ("ok", "difft", "found at %s" % found)


# The pinned ranges the install hints fall back to, mirroring
# ``requirements.txt`` and the doctor skill's remedy table — change all three.
PINNED_SPECIFIERS = {"textual": "textual>=8.2.8,<9",
                     "pydantic": "pydantic>=2.12,<3"}


# PEP 668: a distribution-managed interpreter (Homebrew, Debian, …) plants
# this marker beside its stdlib and pip refuses to install into it without an
# explicit override. The flags below are the pair PEP 668's own error text
# sanctions: ``--user`` lands the package in the user site the same
# interpreter imports from, leaving the distribution's site-packages alone.
EXTERNALLY_MANAGED_MARKER = "EXTERNALLY-MANAGED"
OVERRIDE_FLAGS = "--user --break-system-packages"


def externally_managed(stdlib=None):
    """Whether the running interpreter is externally managed (PEP 668).

    Read-only: the marker file beside the interpreter's stdlib, resolved
    through ``sysconfig``. ``stdlib`` overrides that resolution so the two
    branches are testable without a distribution-managed interpreter.
    """
    if stdlib is None:
        stdlib = sysconfig.get_path("stdlib")
    if not stdlib:
        return False
    return os.path.isfile(os.path.join(stdlib, EXTERNALLY_MANAGED_MARKER))


def _install_hint(root, package, managed=externally_managed):
    """The ``pip install`` hint for ``package`` at ``root``: the checkout's
    ``requirements.txt`` when there is one to install from, and the pinned
    specifier otherwise — a vendored per-repo install carries no
    ``requirements.txt`` to ``-r``.

    On an externally managed interpreter both forms gain
    ``--user --break-system-packages``, so the command printed here is one the
    interpreter that printed it can actually run; on an unmanaged interpreter
    the hints are unchanged.
    """
    flags = "%s " % OVERRIDE_FLAGS if managed() else ""
    if os.path.isfile(os.path.join(root, "requirements.txt")):
        return "pip install %s-r requirements.txt" % flags
    return "pip install %s'%s'" % (flags, PINNED_SPECIFIERS[package])


def check_textual(root, find_spec=importlib.util.find_spec,
                  managed=externally_managed):
    """The delivery board's one third-party dependency — board-only, so its
    absence is a warning."""
    try:
        found = find_spec("textual") is not None
    except (ImportError, ValueError):
        found = False
    if found:
        return ("ok", "textual", "importable; the delivery board can render")
    return ("warn", "textual",
            "not importable — only the board (`shipd board`) needs it; %s"
            % _install_hint(root, "textual", managed=managed))


def _pipeline_needs_pydantic(root):
    """The config path declaring an ``autonomous-pipeline`` whose validation
    imports pydantic, or ``None`` when nothing at ``root`` does.

    Mirrors :func:`spec_common.resolve_pipeline`'s pydantic-import path exactly:
    only a list value or a known preset other than ``default`` reaches the lazy
    import. An absent key, the ``default`` preset, an unknown preset name, a
    value of any other type, or a configuration that will not resolve all stop
    short of it — and the last three already surface through the ``config`` and
    ``pipeline`` checks, so they must not also escalate this one."""
    _load_engine()
    try:
        config, prov = sc.resolve_config(root)
    except sc.ConfigError:
        return None
    raw = config.get(sc.PIPELINE_KEY)
    validated = isinstance(raw, list) or (
        isinstance(raw, str) and raw != "default"
        and raw in sc.PIPELINE_PRESETS)
    if not validated:
        return None
    return prov.get(sc.PIPELINE_KEY, "default")


def check_pydantic(root, find_spec=importlib.util.find_spec,
                   managed=externally_managed):
    """The engine's other scoped third-party dependency — declared-pipeline
    validation only, so its absence is a warning where nothing declares a
    pipeline, and a failure where ``root``'s configuration declares one that
    cannot be validated without it. Probed, never imported, so this binary
    stays stdlib-only."""
    try:
        found = find_spec("pydantic") is not None
    except (ImportError, ValueError):
        found = False
    if found:
        return ("ok", "pydantic",
                "importable; declared pipelines can be validated")
    hint = _install_hint(root, "pydantic", managed=managed)
    declared_by = _pipeline_needs_pydantic(root)
    if declared_by:
        return ("fail", "pydantic",
                "not importable but %s declares an `%s` needing it; %s"
                % (declared_by, sc.PIPELINE_KEY, hint))
    return ("warn", "pydantic",
            "not importable — only declared-pipeline validation needs it; %s"
            % hint)


def check_snapshot(plugin_root):
    """Whether this binary is the newest installed plugin snapshot.

    ``plugin_root`` is the directory holding this ``bin/`` — a version-named
    directory inside a plugin cache, or a repository checkout's ``plugins/s``.
    """
    root = Path(plugin_root)
    if not VERSION_DIR_RE.match(root.name):
        return ("ok", "snapshot", "dev mode — running from %s" % root)
    versions = [name for name in _subdirs(str(root.parent))
                if VERSION_DIR_RE.match(name)]
    newest = max(versions, key=_version_key) if versions else root.name
    if _version_key(newest) > _version_key(root.name):
        return ("warn", "snapshot",
                "running %s but %s is installed — start a new session to load "
                "it; to fetch later versions automatically, enable auto-update "
                "for the shipd marketplace (/plugin), or run `claude plugin "
                "update s@shipd` by hand" % (root.name, newest))
    return ("ok", "snapshot", "%s is the newest installed snapshot" % newest)


def check_statusline(settings_path=None):
    """Whether the shipd statusline is registered in Claude Code's user
    settings. Read-only, and a warning at worst: the statusline only surfaces
    state, so nothing in the workflow is blocked without it. Settings that do
    not parse warn rather than fail — the registration simply cannot be
    confirmed, and only ``statusline install`` may say more about that file.
    """
    path = str(settings_path or _default_settings())
    data, error = _read_settings(path)
    if error is not None:
        return ("warn", "statusline",
                "%s — fix the file, then run `shipd statusline install`"
                % error)
    command = _registered_command(data)
    if command:
        return ("ok", "statusline", "registered in %s: %s" % (path, command))
    return ("warn", "statusline",
            "not registered in %s — run `shipd statusline install` to add the "
            "shipd statusline" % path)


# --- the GitHub-side checks (shipd-cli doctor-github-checks) ---------------
#
# The merge gate is only as strong as the repository's own settings: without a
# protected default branch requiring `semantic-review`, without auto-merge, or
# without the reviewer token, the gate degrades silently. These three checks
# read those settings — and only read them; the verb still mutates nothing, and
# every degradation is a warning at worst, because an unreachable GitHub API
# must never break a preflight that otherwise works offline.

# ``gh api`` names the HTTP status in its error line — ``gh: Not Found (HTTP
# 404)`` — which is how an unprotected branch (404) is told apart from a token
# without admin permission (403) without a second request.
HTTP_STATUS_RE = re.compile(r"\(HTTP (\d{3})\)")

# The phrase a warning carries when the resolved token cannot apply the fix
# itself. The doctor skill keys its report-only demotion off it — change both.
ADMIN_MISSING = "the token lacks admin permission"

# The copilot review gate's workflow, relative to a repository root. The
# reviewer-token check activates only where this file is installed.
GATE_WORKFLOW = os.path.join(".github", "workflows",
                             "copilot-review-gate.yml")

# The wall-clock ceiling on a single ``gh`` invocation. A hung credential
# helper or a stalled connection must cost the preflight seconds, not the
# whole session — a probe that runs out of time degrades exactly like one that
# failed, so the check still reports its ``ok ... skipped`` line.
GH_TIMEOUT = 10


def _gh_run(args):
    """``(returncode, stdout, stderr)`` for ``gh <args...>``.

    The read-only subprocess seam the GitHub-side checks share, isolated here
    so tests inject a stub instead of running the real ``gh``. Bounded by
    :data:`GH_TIMEOUT`; a timeout reports as an ordinary failure, so the
    caller degrades gracefully instead of waiting forever.
    """
    try:
        proc = subprocess.run(["gh"] + list(args), capture_output=True,
                              text=True, timeout=GH_TIMEOUT)
    except subprocess.TimeoutExpired:
        return (1, "", "gh timed out after %ds" % GH_TIMEOUT)
    except OSError as exc:
        return (1, "", str(exc))
    return (proc.returncode, proc.stdout, proc.stderr)


def _gh_api(path, run=_gh_run):
    """``(status, payload)`` for a read-only ``gh api <path>``.

    ``status`` is ``200`` on success, the HTTP status ``gh`` named in its error
    line when it named one, and ``None`` otherwise — offline, a broken
    credential helper, a body that is not JSON. ``payload`` is the decoded
    JSON, or ``None`` wherever there is none to decode.
    """
    code, out, err = run(["api", path])
    if code != 0:
        found = HTTP_STATUS_RE.search(err or "")
        return (int(found.group(1)) if found else None, None)
    try:
        return (200, json.loads(out))
    except ValueError:
        return (None, None)


def _http_reason(status):
    """How a non-200 probe is named in a detail line."""
    return "HTTP %d" % status if status else "no response"


def gh_context(which=shutil.which, gh_status=_gh_auth_status, run=_gh_run):
    """The working directory's GitHub repository, resolved **once** and shared
    by the three GitHub-side checks so one ``gh api repos/<nwo>`` serves them
    all.

    The mapping carries ``skip`` — the reason there is nothing to check —
    whenever ``gh`` is unusable, the working directory resolves no GitHub
    repository, or the repository payload cannot be read. A resolved context
    instead carries ``nwo``, ``default_branch``, ``allow_auto_merge``, and
    ``admin``, any of the last three ``None`` where the payload omits it, so
    API drift degrades to an unverifiable ``ok`` rather than a false alarm.
    """
    if not which("gh"):
        return {"skip": "gh is not on PATH, so the GitHub settings behind the "
                        "merge gate cannot be read"}
    if gh_status() != 0:
        return {"skip": "gh is not authenticated — run `gh auth login` to let "
                        "the preflight read the GitHub settings"}
    code, out, _err = run(["repo", "view", "--json", "nameWithOwner",
                           "-q", ".nameWithOwner"])
    nwo = out.strip() if code == 0 else ""
    if not nwo:
        return {"skip": "the working directory resolves no GitHub repository"}
    status, payload = _gh_api("repos/%s" % nwo, run=run)
    if status != 200 or not isinstance(payload, dict):
        return {"skip": "the GitHub repository %s could not be read (%s)"
                        % (nwo, _http_reason(status))}
    permissions = payload.get("permissions")
    return {"nwo": nwo,
            "default_branch": payload.get("default_branch"),
            "allow_auto_merge": payload.get("allow_auto_merge"),
            "admin": (permissions.get("admin")
                      if isinstance(permissions, dict) else None)}


def _admin_note(context):
    """The clause a warning carries when the resolved token demonstrably cannot
    apply the fix, and the empty string otherwise — an *unknown* permission is
    not a known-missing one, so a payload without ``permissions`` stays
    silent."""
    if context.get("admin") is False:
        return (" (%s on %s, so an admin has to apply the fix)"
                % (ADMIN_MISSING, context.get("nwo")))
    return ""


def _branch_protected(context, branch, run=_gh_run):
    """``branch``'s ``protected`` boolean from the single-branch endpoint, or
    ``None`` when the payload is unreadable or carries no such boolean.

    The fallback for a token without admin permission: it may not read the
    protection payload, but it may still see whether the branch is protected.
    The probe asks for the one branch by name rather than listing the
    repository's branches, because that listing is paginated — a repository
    with more than a page of branches could hide the default branch behind a
    page boundary and degrade this fallback to unverifiable.
    """
    status, payload = _gh_api(
        "repos/%s/branches/%s" % (context["nwo"], branch), run=run)
    if status != 200 or not isinstance(payload, dict):
        return None
    value = payload.get("protected")
    return value if isinstance(value, bool) else None


def check_protection(context, run=_gh_run):
    """Whether the default branch requires the ``semantic-review`` status
    context. Until it does, the review gate's verdict is advisory: a PR merges
    with a failing gate and nothing says so."""
    if context.get("skip"):
        return ("ok", "protection", "skipped: %s" % context["skip"])
    branch = context.get("default_branch")
    if not branch:
        return ("ok", "protection",
                "could not be verified: %s's payload names no default branch"
                % context["nwo"])
    unprotected = (
        "the default branch `%s` of %s is not protected — nothing requires "
        "the `semantic-review` status, so PRs merge with the gate's verdict "
        "ignored"
        % (branch, context["nwo"]))
    status, payload = _gh_api(
        "repos/%s/branches/%s/protection" % (context["nwo"], branch), run=run)
    if status == 200 and isinstance(payload, dict):
        required = payload.get("required_status_checks")
        if required is None:
            # Not an unverifiable read: a readable payload that carries no
            # ``required_status_checks`` at all is the definitive answer that
            # the branch requires *no* status checks, so the gate's status is
            # among the checks nothing requires.
            return ("warn", "protection",
                    "`%s` of %s is protected but requires no status checks at "
                    "all — nothing requires the `semantic-review` status, so "
                    "the gate's verdict is ignored at merge time%s"
                    % (branch, context["nwo"], _admin_note(context)))
        contexts = (required.get("contexts")
                    if isinstance(required, dict) else None)
        if not isinstance(contexts, list):
            # Required status checks *are* configured but the payload's shape
            # is not one this reads — API drift, which degrades to
            # unverifiable silence rather than a false alarm.
            return ("ok", "protection",
                    "could not be verified: `%s` is protected but its "
                    "protection payload lists no required status contexts"
                    % branch)
        if "semantic-review" in contexts:
            return ("ok", "protection",
                    "`%s` requires the `semantic-review` status context"
                    % branch)
        return ("warn", "protection",
                "`%s` of %s is protected but does not require the "
                "`semantic-review` status context — the gate's verdict is "
                "ignored at merge time%s"
                % (branch, context["nwo"], _admin_note(context)))
    if status == 404:
        return ("warn", "protection", unprotected + _admin_note(context))
    if status == 403:
        protected = _branch_protected(context, branch, run=run)
        if protected is None:
            return ("ok", "protection",
                    "could not be verified: reading `%s`'s protection needs "
                    "admin permission on %s, and the branch payload did not "
                    "resolve it either" % (branch, context["nwo"]))
        if protected:
            return ("ok", "protection",
                    "`%s` is protected, but its required status contexts "
                    "could not be verified: %s on %s"
                    % (branch, ADMIN_MISSING, context["nwo"]))
        return ("warn", "protection", unprotected + _admin_note(context))
    return ("ok", "protection",
            "could not be verified: the branch protection probe returned %s"
            % _http_reason(status))


def check_automerge(root, context, resolve=None):
    """Whether the repository allows auto-merge — what ``gh pr merge --auto``
    arms against, and what makes a gated PR land by itself once its checks
    pass. Waived where the resolved ``pr-mode`` is ``draft``: that flow stops
    at an open draft PR and never arms auto-merge at all."""
    if context.get("skip"):
        return ("ok", "automerge", "skipped: %s" % context["skip"])
    allowed = context.get("allow_auto_merge")
    if allowed is True:
        return ("ok", "automerge",
                "auto-merge is enabled on %s" % context["nwo"])
    if allowed is not False:
        return ("ok", "automerge",
                "could not be verified: %s's payload carries no "
                "`allow_auto_merge`" % context["nwo"])
    _load_engine()
    resolve = resolve or sc.resolve_pr_mode
    try:
        mode = resolve(root)
    except sc.ConfigError:
        mode = None
    if mode == "draft":
        return ("ok", "automerge",
                "auto-merge is disabled on %s, but `pr-mode: draft` is "
                "declared — the flow never arms auto-merge" % context["nwo"])
    return ("warn", "automerge",
            "auto-merge is disabled on %s — `gh pr merge --auto` cannot arm, "
            "so every change stops at an open PR%s"
            % (context["nwo"], _admin_note(context)))


def check_copilot_secret(root, context, run=_gh_run):
    """Whether the installed review gate has the reviewer token it needs to run
    Copilot CLI itself. Probed only where the gate workflow is installed at
    ``root`` — the secret matters to nothing else — and a warning at worst:
    without it the gate degrades to the fail-open poll fallback rather than
    breaking."""
    if not os.path.isfile(os.path.join(root, GATE_WORKFLOW)):
        return ("ok", "copilot-secret",
                "skipped: no %s at %s" % (GATE_WORKFLOW, root))
    if context.get("skip"):
        return ("ok", "copilot-secret", "skipped: %s" % context["skip"])
    status, payload = _gh_api("repos/%s/actions/secrets" % context["nwo"],
                              run=run)
    secrets = payload.get("secrets") if isinstance(payload, dict) else None
    if status != 200 or not isinstance(secrets, list):
        return ("ok", "copilot-secret",
                "could not be verified: reading %s's Actions secrets was "
                "denied (%s)" % (context["nwo"], _http_reason(status)))
    names = [entry.get("name") for entry in secrets if isinstance(entry, dict)]
    if "COPILOT_GITHUB_TOKEN" in names:
        return ("ok", "copilot-secret",
                "COPILOT_GITHUB_TOKEN is set on %s — the gate runs the CLI "
                "reviewer mode" % context["nwo"])
    return ("warn", "copilot-secret",
            "the review gate is installed but COPILOT_GITHUB_TOKEN is not set "
            "on %s — the gate degrades to the fail-open poll fallback; see "
            "docs/copilot-review.md%s"
            % (context["nwo"], _admin_note(context)))


def default_checks(root):
    """Every preflight check, required ones first, as ``(level, name, detail)``
    triples. The three GitHub-side checks close the list and share one resolved
    repository context, so the whole preflight makes at most two ``gh`` calls
    beyond the per-check probes."""
    context = gh_context()
    return [check_python(),
            check_git(),
            check_config(root),
            check_pipeline(root),
            check_gh(),
            check_difft(),
            check_textual(root),
            check_pydantic(root),
            check_snapshot(PLUGIN_ROOT),
            check_statusline(),
            check_protection(context),
            check_automerge(root, context),
            check_copilot_secret(root, context)]


def doctor_report(results):
    """``(lines, exit_code)`` for a sequence of check results: one
    ``<level> <check> — <detail>`` line each, a closing summary, and exit ``1``
    iff a check failed — a warning reports but never fails the preflight."""
    lines = ["%s %s — %s" % result for result in results]
    problems = [level for level, _name, _detail in results if level != "ok"]
    failed = any(level == "fail" for level, _name, _detail in results)
    lines.append("doctor: %d problem(s)" % len(problems) if problems
                 else "doctor: ok")
    return lines, 1 if failed else 0


def cmd_doctor(args):
    """Preflight the environment. Read-only: nothing here installs or edits."""
    parser = argparse.ArgumentParser(
        prog="shipd doctor",
        description="Preflight the environment shipd runs in. Reports only.")
    parser.parse_args(args)
    lines, code = doctor_report(default_checks(os.getcwd()))
    for line in lines:
        print(line)
    return code


# ---------------------------------------------------------------------------
# statusline (shipd-cli statusline-verb)
# ---------------------------------------------------------------------------


def _default_settings():
    """Claude Code's user-scope settings file — the scope the plugin itself is
    installed into, and the only scope this verb reads or writes. Resolved per
    call so an injected ``HOME`` is honored."""
    return Path.home() / ".claude" / "settings.json"


def statusline_command(plugin_root):
    """The statusline command this installation would register.

    From a repository checkout the resolved script path is stable, so it is
    registered directly. From a versioned plugin cache snapshot it is not: the
    next ``claude plugin update`` writes a new version directory beside this
    one, so the registration resolves the newest sibling at render time
    (``sort -V``, which orders ``0.6.10`` above ``0.6.9``) instead of pinning
    today's version and stranding the statusline on the next update. Shell
    only either way — no Python is spawned per render.
    """
    root = Path(plugin_root)
    if not VERSION_DIR_RE.match(root.name):
        return "bash %s" % (root / "integrations" / "statusline.sh")
    return ('bash "$(ls -d %s/*/integrations/statusline.sh '
            '| sort -V | tail -n 1)"' % shlex.quote(str(root.parent)))


def _read_settings(path):
    """``(data, error)`` for the settings file at ``path``: the parsed mapping
    (empty when the file is absent), or ``(None, reason)`` when the file exists
    but is unusable — settings we cannot understand are never rewritten."""
    try:
        with open(path, encoding="utf-8") as fh:
            data = json.load(fh)
    except FileNotFoundError:
        return {}, None
    except (OSError, ValueError) as exc:
        return None, "cannot read %s: %s" % (path, exc)
    if not isinstance(data, dict):
        return None, "%s does not hold a JSON object" % path
    return data, None


def _write_settings(path, data):
    """Rewrite ``path`` with ``data``, creating its parent directory. The
    document is written to a temp file in the same directory and renamed over
    the original, so an interrupted write can never leave the user with a
    truncated settings file. An existing file keeps its permission mode — the
    rename would otherwise hand the user mkstemp's private 0600."""
    directory = os.path.dirname(os.path.abspath(path))
    os.makedirs(directory, exist_ok=True)
    try:
        mode = stat.S_IMODE(os.stat(path).st_mode)
    except OSError:
        mode = None
    fd, tmp = tempfile.mkstemp(dir=directory, prefix=".shipd-settings-")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            json.dump(data, fh, indent=2)
            fh.write("\n")
        if mode is not None:
            os.chmod(tmp, mode)
        os.replace(tmp, path)
    except OSError:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise


def _registered_command(data):
    """The statusline command ``data`` registers, or ``None`` when it registers
    none."""
    entry = data.get("statusLine")
    return entry.get("command") if isinstance(entry, dict) else None


def cmd_statusline(args):
    """Report or register the shipd statusline. The one mutating verb in this
    binary, and only under the explicit ``install`` word."""
    parser = argparse.ArgumentParser(
        prog="shipd statusline",
        description="Report or register the shipd statusline in Claude Code's "
                    "user settings. Bare, it reports and changes nothing.")
    parser.add_argument(
        "action", nargs="?", choices=["install"],
        help="install: write the registration (default: report only)")
    parser.add_argument(
        "--settings", default=None,
        help="settings file to use (default: ~/.claude/settings.json)")
    parser.add_argument(
        "--force", action="store_true",
        help="replace a different existing registration")
    opts = parser.parse_args(args)

    path = opts.settings or str(_default_settings())
    command = statusline_command(PLUGIN_ROOT)
    data, error = _read_settings(path)
    if error is not None:
        _err(error)
        return 1
    current = _registered_command(data)

    if opts.action != "install":
        if current is None:
            print("statusline: not registered in %s" % path)
        else:
            print("statusline: registered in %s" % path)
            print("  current: %s" % current)
        print("  this install would register: %s" % command)
        if current != command:
            print("Run `shipd statusline install` to register it.")
        return 0

    if current is not None and current != command and not opts.force:
        _err("%s already registers a different statusline: %s — pass --force "
             "to replace it" % (path, current))
        return 1

    data["statusLine"] = {"type": "command", "command": command}
    try:
        _write_settings(path, data)
    except OSError as exc:
        _err("cannot write %s: %s" % (path, exc))
        return 1
    print("statusline registered in %s" % path)
    print("  %s" % command)
    print("It takes effect in the next Claude Code session.")
    return 0


# ---------------------------------------------------------------------------
# copilot (shipd-cli copilot-verb)
# ---------------------------------------------------------------------------

# The templates this verb installs, and the engine it bundles beside them —
# resolved relative to this file, so a checkout and a cache snapshot behave
# alike.
COPILOT_TEMPLATES = PLUGIN_ROOT / "integrations" / "copilot"
COPILOT_ENGINE = PLUGIN_ROOT / "skills" / "review" / "scripts" / "semdiff.py"

# The four files the verb manages, relative to the target repository root.
COPILOT_SKILL_DIR = os.path.join(".github", "skills", "code-review")
COPILOT_SKILL = os.path.join(COPILOT_SKILL_DIR, "SKILL.md")
COPILOT_SEMDIFF = os.path.join(COPILOT_SKILL_DIR, "scripts", "semdiff.py")
COPILOT_WORKFLOW = os.path.join(".github", "workflows",
                                "copilot-code-review.yml")
# The gate workflow: it bridges Copilot's submitted review into the
# ``semantic-review`` commit status, so a repository requiring that context
# stops waiting on a status nothing posts.
COPILOT_GATE_WORKFLOW = os.path.join(".github", "workflows",
                                     "copilot-review-gate.yml")
COPILOT_MANAGED = (COPILOT_SKILL, COPILOT_SEMDIFF, COPILOT_WORKFLOW,
                   COPILOT_GATE_WORKFLOW)

# The three marker-bearing managed files: managed path -> (template file name,
# ownership-marker pattern). The marker is what makes a file ours; a managed
# path holding anything else is foreign and is never touched without --force.
# The installed ``semdiff.py`` carries no marker of its own — it is kept
# byte-identical to the plugin's copy so drift is a pure content comparison —
# and is owned exactly when the SKILL.md beside it is.
COPILOT_TEMPLATED = {
    COPILOT_SKILL: ("SKILL.md",
                    re.compile(r"^<!-- shipd-copilot v(\S+) -->$", re.M)),
    COPILOT_WORKFLOW: ("copilot-code-review.yml",
                       re.compile(r"^# shipd-copilot v(\S+)$", re.M)),
    COPILOT_GATE_WORKFLOW: ("copilot-review-gate.yml",
                            re.compile(r"^# shipd-copilot v(\S+)$", re.M)),
}


def _read_bytes(path):
    """``path``'s bytes, or ``None`` when it cannot be read."""
    try:
        with open(path, "rb") as fh:
            return fh.read()
    except OSError:
        return None


def _copilot_marker(path, pattern):
    """The ownership-marker version the file at ``path`` carries, or ``None``
    when it carries none — including when it is unreadable or not text, which
    a foreign file may well be."""
    raw = _read_bytes(path)
    if raw is None:
        return None
    try:
        text = raw.decode("utf-8")
    except UnicodeDecodeError:
        return None
    found = pattern.search(text)
    return found.group(1) if found else None


def copilot_states(root, version):
    """``[(relative path, state, detail)]`` for the four managed files under
    ``root``, in :data:`COPILOT_MANAGED` order.

    ``installed`` is a marker at ``version``; ``stale`` an older marker or an
    engine that has drifted from the plugin's; ``foreign`` a managed path this
    install does not own; ``absent`` no file at all."""
    engine = _read_bytes(str(COPILOT_ENGINE))
    states = {}
    markers = {}
    for relative, (_template, pattern) in COPILOT_TEMPLATED.items():
        target = os.path.join(root, relative)
        if not os.path.exists(target):
            states[relative] = ("absent", "not installed")
            markers[relative] = None
            continue
        marker = _copilot_marker(target, pattern)
        markers[relative] = marker
        if marker is None:
            states[relative] = (
                "foreign", "exists without a shipd-copilot marker")
        elif marker != version:
            states[relative] = (
                "stale", "marker v%s — `shipd copilot add` refreshes it to v%s"
                % (marker, version))
        else:
            states[relative] = ("installed", "shipd-copilot v%s" % version)

    target = os.path.join(root, COPILOT_SEMDIFF)
    if not os.path.exists(target):
        states[COPILOT_SEMDIFF] = ("absent", "not installed")
    elif markers[COPILOT_SKILL] is None:
        states[COPILOT_SEMDIFF] = (
            "foreign", "the SKILL.md beside it is not shipd-owned")
    elif engine is None or _read_bytes(target) != engine:
        states[COPILOT_SEMDIFF] = (
            "stale", "differs from the plugin's engine — `shipd copilot add` "
                     "refreshes it")
    else:
        states[COPILOT_SEMDIFF] = (
            "installed", "byte-identical to the plugin's engine")

    # The skill is only installed when the engine it bundles is: a drifted
    # semdiff.py is the skill's own staleness, whatever its marker says.
    if (states[COPILOT_SKILL][0] == "installed"
            and states[COPILOT_SEMDIFF][0] != "installed"):
        states[COPILOT_SKILL] = (
            "stale", "its bundled semdiff.py is %s"
                     % states[COPILOT_SEMDIFF][0])
    return [(relative,) + states[relative] for relative in COPILOT_MANAGED]


def _copilot_render(relative, version):
    """The template for managed path ``relative``, its ``{version}``
    placeholder resolved, as bytes ready to write."""
    name, _pattern = COPILOT_TEMPLATED[relative]
    with open(COPILOT_TEMPLATES / name, encoding="utf-8") as fh:
        text = fh.read()
    return text.replace("{version}", version).encode("utf-8")


def _atomic_write(path, data, mode, prefix=".shipd-copilot-"):
    """Write ``data`` to ``path`` atomically, creating its parents — the
    same-directory temp file and rename of :func:`_write_settings`, so an
    interrupted install can never leave a half-written file in the user's
    repository. ``mkstemp``'s private 0600 is replaced by ``mode``."""
    directory = os.path.dirname(os.path.abspath(path))
    os.makedirs(directory, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=directory, prefix=prefix)
    try:
        with os.fdopen(fd, "wb") as fh:
            fh.write(data)
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    except OSError:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise


def _copilot_report(root, version, states):
    """The bare verb's read-only report. Nothing here writes."""
    print("copilot review skill in %s (this install: v%s)" % (root, version))
    for relative, state, detail in states:
        print("  %s %s — %s" % (state, relative, detail))
    print("`shipd copilot add` installs or refreshes those files; "
          "`shipd copilot remove` deletes the ones it owns.")
    print("Automatic review is enabled on GitHub, not here — add a branch "
          "ruleset requiring Copilot code review on the protected branch.")
    print("The Copilot code-review surface exposes no repository-side model "
          "selection, so nothing here pins a model.")
    return 0


def _copilot_add(root, version):
    """Install or refresh the four managed files. Every payload is prepared
    before the first write, so a broken template installs nothing."""
    try:
        engine = _read_bytes(str(COPILOT_ENGINE))
        if engine is None:
            _err("cannot read %s" % COPILOT_ENGINE)
            return 1
        payloads = [
            (COPILOT_SKILL, _copilot_render(COPILOT_SKILL, version), 0o644),
            (COPILOT_SEMDIFF, engine,
             stat.S_IMODE(os.stat(COPILOT_ENGINE).st_mode)),
            (COPILOT_WORKFLOW, _copilot_render(COPILOT_WORKFLOW, version),
             0o644),
            (COPILOT_GATE_WORKFLOW,
             _copilot_render(COPILOT_GATE_WORKFLOW, version), 0o644),
        ]
    except (OSError, ValueError) as exc:
        _err("cannot read the copilot templates in %s: %s"
             % (COPILOT_TEMPLATES, exc))
        return 1

    for relative, data, mode in payloads:
        target = os.path.join(root, relative)
        try:
            _atomic_write(target, data, mode)
        except OSError as exc:
            _err("cannot write %s: %s" % (target, exc))
            return 1
    for relative, _data, _mode in payloads:
        print("wrote %s" % relative)
    print("Copilot code review reads these from a pull request's head branch. "
          "Enable automatic review with a GitHub branch ruleset.")
    return 0


def _copilot_remove(root):
    """Delete the managed files and prune the skill tree it emptied."""
    removed = []
    for relative in COPILOT_MANAGED:
        target = os.path.join(root, relative)
        try:
            os.remove(target)
        except FileNotFoundError:
            continue
        except OSError as exc:
            _err("cannot remove %s: %s" % (target, exc))
            return 1
        removed.append(relative)
    # Innermost first, and only while empty — a directory still holding
    # anything of the user's stays exactly where it is.
    for relative in (os.path.join(COPILOT_SKILL_DIR, "scripts"),
                     COPILOT_SKILL_DIR):
        try:
            os.rmdir(os.path.join(root, relative))
        except FileNotFoundError:
            continue
        except OSError:
            break
    if not removed:
        print("nothing to remove: no shipd copilot files in %s" % root)
        return 0
    for relative in removed:
        print("removed %s" % relative)
    return 0


def cmd_copilot(args):
    """Report on, install, or remove the shipd Copilot code-review skill in a
    repository. Bare it is read-only; only the explicit words ``add`` and
    ``remove`` write, and only inside the four managed paths. Nothing here
    runs ``gh`` or touches the network."""
    parser = argparse.ArgumentParser(
        prog="shipd copilot",
        description="Maintain the shipd Copilot code-review skill in a "
                    "repository. Bare, it reports and changes nothing.")
    parser.add_argument(
        "action", nargs="?", choices=["add", "remove"],
        help="add: install or refresh the files; remove: delete them "
             "(default: report only)")
    parser.add_argument("--root", default=os.getcwd(),
                        help="repository to maintain (default: cwd)")
    parser.add_argument(
        "--force", action="store_true",
        help="act on a managed path this install does not own")
    opts = parser.parse_args(args)
    root = os.path.abspath(opts.root)

    try:
        version = _plugin_version()
    except (OSError, ValueError, KeyError, TypeError) as exc:
        _err("cannot read %s: %s" % (MANIFEST, exc))
        return 1

    states = copilot_states(root, version)
    if opts.action is None:
        return _copilot_report(root, version, states)

    foreign = [relative for relative, state, _detail in states
               if state == "foreign"]
    if foreign and not opts.force:
        _err("%s: not written by shipd copilot (no ownership marker) — pass "
             "--force to %s %s anyway"
             % (", ".join(foreign), opts.action,
                "them" if len(foreign) > 1 else "it"))
        return 1
    if opts.action == "add":
        return _copilot_add(root, version)
    return _copilot_remove(root)


# ---------------------------------------------------------------------------
# vendor (shipd-cli vendor-verb)
# ---------------------------------------------------------------------------

# The vendored install's fixed names: the marketplace the generated manifest
# declares, the plugin inside it, and the identifier Claude Code enables.
VENDOR_MARKETPLACE = "shipd"
VENDOR_PLUGIN = "s"
VENDOR_PLUGIN_ID = "%s@%s" % (VENDOR_PLUGIN, VENDOR_MARKETPLACE)

# The settings file the verb merges into, relative to the target repository,
# and the two keys it manages there. A ``statusLine`` is registered too, but
# only into a file carrying none — so it is never part of ownership.
VENDOR_SETTINGS = os.path.join(".claude", "settings.json")
VENDOR_ENABLED_KEY = "enabledPlugins"
VENDOR_MARKETPLACES_KEY = "extraKnownMarketplaces"

# The content scaffold, created only where missing and never removed.
VENDOR_SCAFFOLD = ("verified", "planned", "completed")

# Directories the vendored copy never carries. ``__pycache__`` holds generated
# bytecode, not part of the shipping unit: it appears in whichever plugin tree
# has run the engine, so copying it would both litter the target repository and
# report the vendored tree ``stale`` the first time the source ran a script.
VENDOR_EXCLUDED_DIRS = ("__pycache__",)


def vendor_layout(root):
    """The managed paths for ``root``, each *relative* to it, with the content
    directory resolved through the engine's layered configuration — a repo
    declaring a custom ``dir`` vendors under that name and points its settings
    at it. Raises ``sc.ConfigError`` when the configuration is unusable."""
    _load_engine()
    config, _prov = sc.resolve_config(root)
    content = sc.specs_dirname(config)
    plugin = os.path.join(content, "plugin")
    return {
        "content": content,
        "plugin": plugin,
        "tree": os.path.join(plugin, VENDOR_PLUGIN),
        "marketplace": os.path.join(plugin, ".claude-plugin",
                                    "marketplace.json"),
        "settings": VENDOR_SETTINGS,
        "scaffold": os.path.join(content,
                                 "{%s}" % ",".join(VENDOR_SCAFFOLD)),
    }


def _vendor_manifest(root, layout):
    """The vendored plugin manifest's path — the ownership marker's home."""
    return os.path.join(root, layout["tree"], ".claude-plugin", "plugin.json")


def _vendor_ownership(root, layout):
    """``(ownership, marker version)`` of the vendored plugin directory:
    ``absent`` when there is none, ``owned`` with the manifest's ``version``
    when its manifest parses and names ``s``, and ``foreign`` for a plugin
    directory that exists as anything else."""
    if not os.path.isdir(os.path.join(root, layout["tree"])):
        return "absent", None
    try:
        with open(_vendor_manifest(root, layout), encoding="utf-8") as fh:
            data = json.load(fh)
    except (OSError, ValueError):
        return "foreign", None
    if not isinstance(data, dict) or data.get("name") != VENDOR_PLUGIN:
        return "foreign", None
    return "owned", data.get("version")


def _vendor_tree_files(base):
    """Sorted ``base``-relative paths of every file under it, the generated
    bytecode caches excluded — the file set both the copy and the drift
    comparison work over."""
    found = []
    for current, dirs, names in os.walk(base):
        dirs[:] = [name for name in dirs if name not in VENDOR_EXCLUDED_DIRS]
        for name in names:
            found.append(os.path.relpath(os.path.join(current, name), base))
    return sorted(found)


def vendor_drift(source, target):
    """``(missing, extraneous, differing)`` relative paths between the running
    plugin tree ``source`` and the vendored ``target``. All three empty is
    byte equality — the only state ``add`` leaves behind."""
    want = set(_vendor_tree_files(source))
    have = set(_vendor_tree_files(target))
    differing = [relative for relative in sorted(want & have)
                 if _read_bytes(os.path.join(source, relative))
                 != _read_bytes(os.path.join(target, relative))]
    return sorted(want - have), sorted(have - want), differing


def _vendor_tree_state(root, layout, version):
    """The vendored plugin tree's state, drift included."""
    ownership, marker = _vendor_ownership(root, layout)
    if ownership == "absent":
        return ("absent", "not installed")
    if ownership == "foreign":
        return ("foreign",
                "a plugin directory without a manifest naming `%s` — "
                "`shipd vendor add --force` replaces it" % VENDOR_PLUGIN)
    if marker != version:
        return ("stale",
                "vendored v%s — `shipd vendor add` refreshes it to v%s"
                % (marker, version))
    missing, extraneous, differing = vendor_drift(
        str(PLUGIN_ROOT), os.path.join(root, layout["tree"]))
    if missing or extraneous or differing:
        return ("stale",
                "v%s but drifted: %d missing, %d extraneous, %d changed — "
                "`shipd vendor add` rewrites the tree"
                % (version, len(missing), len(extraneous), len(differing)))
    return ("installed",
            "v%s, byte-identical to this install" % version)


def vendor_marketplace_document(layout):
    """The marketplace manifest the vendored tree is registered through: the
    ``shipd`` marketplace with the single plugin ``s`` beside it."""
    return {
        "$schema": "https://json.schemastore.org/claude-code-marketplace.json",
        "name": VENDOR_MARKETPLACE,
        "owner": {"name": VENDOR_MARKETPLACE},
        "description": "Vendored shipd plugin, installed into this repository "
                       "by `shipd vendor add`.",
        "plugins": [{
            "name": VENDOR_PLUGIN,
            "source": "./%s" % VENDOR_PLUGIN,
            "description": "Shipd commands and skills, namespaced under /s:",
            "category": "productivity",
            "keywords": ["shipd", "s", "workflow"],
        }],
    }


def _vendor_declares_the_plugin(data):
    """Whether ``data`` is a marketplace manifest declaring this vendored
    install. Compared by declaration, not by bytes: the surrounding prose keys
    are ours to change without calling every existing manifest stale."""
    if not isinstance(data, dict) or data.get("name") != VENDOR_MARKETPLACE:
        return False
    plugins = data.get("plugins")
    if not isinstance(plugins, list) or len(plugins) != 1:
        return False
    entry = plugins[0]
    return (isinstance(entry, dict) and entry.get("name") == VENDOR_PLUGIN
            and entry.get("source") == "./%s" % VENDOR_PLUGIN)


def _vendor_marketplace_state(root, layout, tree_state):
    """The generated marketplace manifest's state. It carries no marker of its
    own — like the copilot engine beside its SKILL.md, it is owned exactly when
    the plugin tree beside it is."""
    path = os.path.join(root, layout["marketplace"])
    if not os.path.exists(path):
        return ("absent", "not installed")
    if tree_state == "foreign":
        return ("foreign", "the plugin directory beside it is not shipd's")
    try:
        with open(path, encoding="utf-8") as fh:
            data = json.load(fh)
    except (OSError, ValueError):
        return ("stale",
                "not readable as JSON — `shipd vendor add` regenerates it")
    if _vendor_declares_the_plugin(data):
        return ("installed",
                "marketplace `%s` with plugin `%s` at ./%s"
                % (VENDOR_MARKETPLACE, VENDOR_PLUGIN, VENDOR_PLUGIN))
    return ("stale",
            "does not declare `%s` at ./%s — `shipd vendor add` regenerates it"
            % (VENDOR_PLUGIN, VENDOR_PLUGIN))


def vendor_marketplace_entry(layout):
    """The ``extraKnownMarketplaces.shipd`` value: a directory source at the
    vendored plugin directory, declared *relative* to the repository root so it
    resolves in every clone, with auto-update on."""
    return {"source": {"source": "directory",
                       "path": layout["plugin"].replace(os.sep, "/")},
            "autoUpdate": True}


def vendor_statusline_command(layout):
    """The statusline the vendored install would register — the copy inside
    the vendored tree, again repository-relative."""
    return "bash %s" % os.path.join(
        layout["tree"], "integrations", "statusline.sh").replace(os.sep, "/")


def _vendor_settings_state(root, layout):
    """The target's ``.claude/settings.json`` state, judged on the two managed
    keys alone. A ``statusLine`` is deliberately excluded: ``add`` writes one
    only into a file carrying none, so somebody else's is not drift."""
    path = os.path.join(root, layout["settings"])
    data, error = _read_settings(path)
    if error is not None:
        return ("foreign", "%s — fix the file, then re-run" % error)
    enabled = data.get(VENDOR_ENABLED_KEY)
    marketplaces = data.get(VENDOR_MARKETPLACES_KEY)
    has_enabled = isinstance(enabled, dict) and VENDOR_PLUGIN_ID in enabled
    has_marketplace = (isinstance(marketplaces, dict)
                       and VENDOR_MARKETPLACE in marketplaces)
    if not has_enabled and not has_marketplace:
        return ("absent", "no shipd keys registered")
    if (has_enabled and enabled.get(VENDOR_PLUGIN_ID) is True
            and has_marketplace
            and marketplaces.get(VENDOR_MARKETPLACE)
            == vendor_marketplace_entry(layout)):
        return ("installed",
                "`%s` enabled from the vendored %s"
                % (VENDOR_PLUGIN_ID, layout["plugin"]))
    return ("stale",
            "the shipd keys do not match this install — "
            "`shipd vendor add` merges them")


def _vendor_scaffold_state(root, layout):
    """The content scaffold's state. It holds the user's own spec library, so
    it is only ever created — never rewritten, never removed."""
    present = [name for name in VENDOR_SCAFFOLD
               if os.path.isdir(os.path.join(root, layout["content"], name))]
    if not present:
        return ("absent", "no content scaffold yet")
    if len(present) == len(VENDOR_SCAFFOLD):
        return ("installed",
                "%s exist" % ", ".join("%s/" % name
                                       for name in VENDOR_SCAFFOLD))
    return ("stale",
            "only %s — `shipd vendor add` creates the rest"
            % ", ".join("%s/" % name for name in present))


def vendor_states(root, layout, version):
    """``[(relative label, state, detail)]`` for the four managed surfaces, in
    a fixed order: the vendored tree, its marketplace manifest, the settings
    merge, and the content scaffold."""
    tree = _vendor_tree_state(root, layout, version)
    return [(layout["tree"],) + tree,
            (layout["marketplace"],)
            + _vendor_marketplace_state(root, layout, tree[0]),
            (layout["settings"],) + _vendor_settings_state(root, layout),
            (layout["scaffold"],) + _vendor_scaffold_state(root, layout)]


def _vendor_prune_empty_dirs(base):
    """Remove directories the pruning emptied, innermost first; ``base``
    itself stays. A directory still holding anything is left alone."""
    for current, _dirs, _names in os.walk(base, topdown=False):
        if os.path.abspath(current) == os.path.abspath(base):
            continue
        try:
            os.rmdir(current)
        except OSError:
            continue


def _vendor_sync_tree(root, layout):
    """Rewrite the vendored tree to byte equality with the running plugin,
    pruning anything extraneous. Only the files that actually differ are
    written, so a repeated ``add`` touches nothing. Returns
    ``(written, pruned)`` counts."""
    source = str(PLUGIN_ROOT)
    target = os.path.join(root, layout["tree"])
    missing, extraneous, differing = vendor_drift(source, target)
    for relative in missing + differing:
        origin = os.path.join(source, relative)
        data = _read_bytes(origin)
        if data is None:
            raise OSError("cannot read %s" % origin)
        _atomic_write(os.path.join(target, relative), data,
                      stat.S_IMODE(os.stat(origin).st_mode),
                      prefix=".shipd-vendor-")
    for relative in extraneous:
        os.remove(os.path.join(target, relative))
    if extraneous:
        _vendor_prune_empty_dirs(target)
    return len(missing) + len(differing), len(extraneous)


def _vendor_write_marketplace(root, layout):
    """(Re)generate the marketplace manifest beside the vendored tree."""
    document = json.dumps(vendor_marketplace_document(layout), indent=2) + "\n"
    _atomic_write(os.path.join(root, layout["marketplace"]),
                  document.encode("utf-8"), 0o644, prefix=".shipd-vendor-")


def _vendor_merge_settings(layout, data):
    """Merge the two managed keys into ``data`` declaratively — the same value
    however often it runs. A ``statusLine`` is registered only into settings
    carrying none: replacing somebody else's is never this verb's call."""
    for key in (VENDOR_ENABLED_KEY, VENDOR_MARKETPLACES_KEY):
        if not isinstance(data.get(key), dict):
            data[key] = {}
    data[VENDOR_ENABLED_KEY][VENDOR_PLUGIN_ID] = True
    data[VENDOR_MARKETPLACES_KEY][VENDOR_MARKETPLACE] = (
        vendor_marketplace_entry(layout))
    if "statusLine" not in data:
        data["statusLine"] = {"type": "command",
                              "command": vendor_statusline_command(layout)}
    return data


def _vendor_scaffold(root, layout):
    """Create the content scaffold where it is missing. Existing directories
    and every spec artifact inside them are left exactly as they are."""
    created = []
    for name in VENDOR_SCAFFOLD:
        directory = os.path.join(root, layout["content"], name)
        if not os.path.isdir(directory):
            created.append(name)
        os.makedirs(directory, exist_ok=True)
        keep = os.path.join(directory, ".gitkeep")
        if not os.path.exists(keep):
            _atomic_write(keep, b"", 0o644, prefix=".shipd-vendor-")
    return created


def _vendor_add(root, layout, version):
    """Install or refresh all four surfaces.

    The settings file is read before the first write, so settings this verb
    cannot understand stop the install rather than being clobbered by it —
    the guard :func:`cmd_statusline` applies to the same file.
    """
    settings_path = os.path.join(root, layout["settings"])
    data, error = _read_settings(settings_path)
    if error is not None:
        _err(error)
        return 1
    ownership, _marker = _vendor_ownership(root, layout)
    try:
        if ownership == "foreign":
            # Forced past the guard in :func:`cmd_vendor`: the directory is
            # replaced wholesale rather than merged into.
            shutil.rmtree(os.path.join(root, layout["tree"]))
        written, pruned = _vendor_sync_tree(root, layout)
        _vendor_write_marketplace(root, layout)
        _write_settings(settings_path, _vendor_merge_settings(layout, data))
        created = _vendor_scaffold(root, layout)
    except OSError as exc:
        _err("cannot write the vendored install in %s: %s" % (root, exc))
        return 1

    print("vendored %s at v%s (%d file(s) written, %d pruned)"
          % (layout["tree"], version, written, pruned))
    print("wrote %s" % layout["marketplace"])
    print("merged `%s` and `%s` into %s"
          % (VENDOR_ENABLED_KEY, VENDOR_MARKETPLACES_KEY, layout["settings"]))
    print("scaffold %s: %s"
          % (layout["scaffold"],
             "created %s" % ", ".join(created) if created
             else "already present"))
    print("It takes effect in the next Claude Code session, once the folder's "
          "trust dialog has been accepted.")
    return 0


def _vendor_unmerge_settings(layout, data):
    """Drop the two managed keys from ``data``, and a ``statusLine`` only when
    its command points into the vendored tree — one this verb did not write is
    the user's, and stays. Emptied managed keys are dropped whole, so removal
    leaves no residue behind. Returns the removed key names."""
    removed = []
    for key, name in ((VENDOR_ENABLED_KEY, VENDOR_PLUGIN_ID),
                      (VENDOR_MARKETPLACES_KEY, VENDOR_MARKETPLACE)):
        entry = data.get(key)
        if not isinstance(entry, dict) or name not in entry:
            continue
        del entry[name]
        removed.append("%s.%s" % (key, name))
        if not entry:
            del data[key]
    command = _registered_command(data)
    if command and layout["tree"].replace(os.sep, "/") in command:
        del data["statusLine"]
        removed.append("statusLine")
    return removed


def _vendor_remove(root, layout):
    """Delete the vendored plugin directory and unmerge the settings keys.

    The content scaffold and everything under it is the user's spec library,
    never this verb's to remove — only ``<content-dir>/plugin/`` goes.
    """
    settings_path = os.path.join(root, layout["settings"])
    data, error = _read_settings(settings_path)
    if error is not None:
        _err(error)
        return 1
    plugin = os.path.join(root, layout["plugin"])
    removed = []
    try:
        if os.path.isdir(plugin):
            shutil.rmtree(plugin)
            removed.append(layout["plugin"])
        keys = _vendor_unmerge_settings(layout, data)
        if keys:
            _write_settings(settings_path, data)
            removed.extend("%s (%s)" % (layout["settings"], key)
                           for key in keys)
    except OSError as exc:
        _err("cannot remove the vendored install in %s: %s" % (root, exc))
        return 1
    if not removed:
        print("nothing to remove: no vendored shipd install in %s" % root)
        return 0
    for entry in removed:
        print("removed %s" % entry)
    print("The content scaffold and every spec under it were left untouched.")
    return 0


def _vendor_report(root, version, states):
    """The bare verb's read-only report. Nothing here writes."""
    print("vendored shipd plugin in %s (this install: v%s)" % (root, version))
    for label, state, detail in states:
        print("  %s %s — %s" % (state, label, detail))
    print("`shipd vendor add` installs or refreshes those surfaces; "
          "`shipd vendor remove` deletes the ones it owns.")
    print("A collaborator then needs only to clone this repository and accept "
          "Claude Code's folder trust dialog — no marketplace registration, "
          "no network.")
    return 0


def cmd_vendor(args):
    """Report on, install, or remove a vendored per-repo shipd install. Bare it
    is read-only; only the explicit words ``add`` and ``remove`` write, and
    only inside the four managed surfaces. Nothing here runs ``claude`` or
    ``gh``, or touches the network."""
    parser = argparse.ArgumentParser(
        prog="shipd vendor",
        description="Maintain a vendored per-repo shipd install in a "
                    "repository. Bare, it reports and changes nothing.")
    parser.add_argument(
        "action", nargs="?", choices=["add", "remove"],
        help="add: install or refresh the vendored plugin and its wiring; "
             "remove: delete the ones it owns (default: report only)")
    parser.add_argument("--root", default=os.getcwd(),
                        help="repository to maintain (default: cwd)")
    parser.add_argument(
        "--force", action="store_true",
        help="act on a vendored plugin directory this install does not own")
    opts = parser.parse_args(args)
    root = os.path.abspath(opts.root)

    try:
        version = _plugin_version()
    except (OSError, ValueError, KeyError, TypeError) as exc:
        _err("cannot read %s: %s" % (MANIFEST, exc))
        return 1
    _load_engine()
    try:
        layout = vendor_layout(root)
    except sc.ConfigError as exc:
        _err("%s" % exc)
        return 1

    states = vendor_states(root, layout, version)
    if opts.action is None:
        return _vendor_report(root, version, states)

    # Only the plugin directory carries ownership, so it is the only surface
    # the force guard speaks for. (Unreadable settings are refused separately,
    # inside each mode, and never forced past.)
    ownership, _marker = _vendor_ownership(root, layout)
    if ownership == "foreign" and not opts.force:
        _err("%s: not a shipd-vendored plugin (its manifest does not name "
             "`%s`) — pass --force to %s it anyway"
             % (layout["tree"], VENDOR_PLUGIN, opts.action))
        return 1
    if opts.action == "add":
        return _vendor_add(root, layout, version)
    return _vendor_remove(root, layout)


# ---------------------------------------------------------------------------
# harness (harness-registry harness-read-verbs)
# ---------------------------------------------------------------------------

# The registry fields ``show`` prints, in the order the entries declare them.
HARNESS_FIELDS = ("id", "name", "repo_pattern", "user_dir", "dialect",
                  "frontmatter", "features")


def _harness_field(value):
    """One registry field's text rendering: a tuple joins with commas, and an
    absent value — ``None`` or an empty tuple — reads as ``none`` rather than
    as a blank that looks like a truncated report."""
    if value is None:
        return "none"
    if isinstance(value, (tuple, list)):
        return ", ".join(value) if value else "none"
    return value


def _harness_selection(ids):
    """``(entries, reason)`` — the registry entries ``ids`` names, or a single
    reason naming the first unknown one."""
    entries = []
    for harness_id in ids:
        entry = hr.get(harness_id)
        if entry is None:
            return None, ("unknown harness '%s' — `shipd harness` lists them"
                          % harness_id)
        entries.append(entry)
    return entries, None


def _harness_status_report(root, mode, report):
    """The ``status`` action's text rendering. Nothing here writes."""
    where = root if mode == hg.REPO_MODE else "your home directory"
    print("harness commands in %s" % where)
    width = max(len(record["state"]) for record in report.values())
    for harness_id, record in report.items():
        # A harness with no surface here has nothing to name but the reason.
        detail = record["detail"]
        if record["surface"] is not None:
            detail = "%s (%s)" % (record["surface"], detail)
        print("  %-*s %s — %s" % (width, record["state"], harness_id, detail))
    return 0


def cmd_harness(args):
    """Report the harness-adapter registry, or maintain the generated ``/s:``
    command files it describes.

    ``list``, ``show`` and ``status`` are read-only; only the explicit words
    ``add`` and ``remove`` write, and only inside paths the registry itself
    names. Nothing here touches the network.
    """
    parser = argparse.ArgumentParser(
        prog="shipd harness",
        description="The harness-adapter registry: the coding harnesses shipd "
                    "generates commands for, how each wants them, and the "
                    "generated files themselves.")
    parser.add_argument(
        "action", nargs="?",
        choices=["list", "show", "add", "remove", "status"], default="list",
        help="list: one line per harness (the default); "
             "show: every field of one harness; "
             "add/remove: maintain the generated command files; "
             "status: report what is installed")
    parser.add_argument(
        "ids", nargs="*",
        help="the harness ids to act on (`show` takes exactly one; "
             "`status` defaults to all)")
    parser.add_argument("--all", action="store_true", dest="all",
                        help="act on every harness in the registry")
    parser.add_argument("--root", default=os.getcwd(),
                        help="repository to maintain (default: cwd)")
    parser.add_argument("--user", action="store_true",
                        help="act on the user-global surfaces instead of the "
                             "repository's")
    parser.add_argument("--force", action="store_true",
                        help="act on a target file this install does not own")
    parser.add_argument("--json", action="store_true", dest="json",
                        help="emit one machine-readable JSON document on "
                             "stdout instead of the text report")
    opts = parser.parse_args(args)
    _load_registry()

    if opts.action in ("add", "remove", "status"):
        return _cmd_harness_files(opts)

    if opts.action == "show":
        if not opts.ids:
            _err("shipd harness show needs a harness id — "
                 "`shipd harness` lists them")
            return 2
        if len(opts.ids) > 1:
            _err("shipd harness show takes one harness id, got %d"
                 % len(opts.ids))
            return 2
        entry = hr.get(opts.ids[0])
        if entry is None:
            _err("unknown harness '%s' — `shipd harness` lists them"
                 % opts.ids[0])
            return 1
        if opts.json:
            print(json.dumps(entry))
            return 0
        width = max(len(field) for field in HARNESS_FIELDS)
        for field in HARNESS_FIELDS:
            print("%-*s  %s" % (width, field, _harness_field(entry[field])))
        return 0

    if opts.ids:
        _err("shipd harness list takes no harness id — did you mean "
             "`shipd harness show %s`?" % opts.ids[0])
        return 2
    if opts.json:
        print(json.dumps(list(hr.HARNESSES)))
        return 0

    id_width = max(len(entry["id"]) for entry in hr.HARNESSES)
    name_width = max(len(entry["name"]) for entry in hr.HARNESSES)
    dialect_width = max(len(entry["dialect"]) for entry in hr.HARNESSES)
    for entry in hr.HARNESSES:
        count = len(entry["features"])
        print("%-*s  %-*s  %-*s  %d feature%s"
              % (id_width, entry["id"], name_width, entry["name"],
                 dialect_width, entry["dialect"], count,
                 "" if count == 1 else "s"))
    return 0


def _cmd_harness_files(opts):
    """The ``add``/``remove``/``status`` actions over the generated files."""
    _load_generate()
    _load_engine()
    root = os.path.abspath(opts.root)
    mode = hg.USER_MODE if opts.user else hg.REPO_MODE

    if opts.ids and opts.all:
        _err("shipd harness %s takes harness ids or --all, not both"
             % opts.action)
        return 2
    if opts.action in ("add", "remove") and not opts.ids and not opts.all:
        _err("shipd harness %s needs one or more harness ids or --all — "
             "`shipd harness` lists them" % opts.action)
        return 2

    if opts.ids:
        entries, reason = _harness_selection(opts.ids)
        if reason is not None:
            _err(reason)
            return 1
    else:
        entries = list(hr.HARNESSES)

    try:
        if opts.action == "status":
            report = hg.status(entries, mode, root)
            if opts.json:
                print(json.dumps(report))
                return 0
            return _harness_status_report(root, mode, report)
        action = hg.add if opts.action == "add" else hg.remove
        lines, reason = action(entries, mode, root, force=opts.force)
    except sc.ConfigError as exc:
        _err("%s" % exc)
        return 1
    except ValueError as exc:
        _err("cannot render the harness command files: %s" % exc)
        return 1
    except OSError as exc:
        _err("cannot maintain the harness command files: %s" % exc)
        return 1

    if reason is not None:
        _err(reason)
        return 1
    for line in lines:
        print(line)
    return 0


# ---------------------------------------------------------------------------
# install (install-tui install-verb)
# ---------------------------------------------------------------------------


def cmd_install(args):
    """Ask which coding harnesses the user works in and install the chosen
    ones' ``/s:`` commands into their home directory.

    In-binary like ``harness``: it writes only user-domain files, and it owns
    the terminal for the length of the question, so it must not replace this
    process. Everything it does lives in ``install_tui``; this is the verb's
    argument surface and nothing else.
    """
    _load_install_tui()
    return iu.main(args)


# ---------------------------------------------------------------------------
# update (shipd-cli cli-update)
# ---------------------------------------------------------------------------

# The registered marketplace name, the installed plugin's id, and the entry
# name inside that marketplace's own manifest — the three identifiers
# ``cmd_update`` resolves the installed and available versions through.
CLAUDE_MARKETPLACE = "shipd"
CLAUDE_PLUGIN_ID = "s@shipd"
CLAUDE_PLUGIN_NAME = "s"

# The wall-clock ceiling on the marketplace refresh. A hung `claude` must
# cost the verb seconds, not stall it forever — reporting "up to date" from a
# refresh that never ran would be worse than erroring.
MARKETPLACE_TIMEOUT = 120


class UpdateError(Exception):
    """Raised by the version-resolution helpers below; its message is the
    ``Error:`` reason :func:`cmd_update` reports."""


def _plugins_home():
    """``~/.claude/plugins`` — the directory holding both the marketplace
    registration and (by default) the plugin cache, resolved against the
    current ``HOME`` so tests can point it elsewhere."""
    return Path.home() / ".claude" / "plugins"


def _cache_root():
    """The plugin cache root the installed version is resolved under —
    ``SHIPD_PLUGIN_CACHE`` when set, otherwise
    ``<plugins-home>/cache/shipd/s``, mirroring ``install.sh``'s launcher."""
    override = os.environ.get("SHIPD_PLUGIN_CACHE")
    if override:
        return override
    return str(_plugins_home() / "cache" / "shipd" / "s")


def newest_installed(cache_root):
    """The newest version-named directory under ``cache_root``, by the same
    dotted-integer ordering :func:`check_snapshot` uses, or ``None`` when the
    root is absent, unreadable, or holds no version directory."""
    versions = [name for name in _subdirs(cache_root)
                if VERSION_DIR_RE.match(name)]
    return max(versions, key=_version_key) if versions else None


def marketplace_location(plugins_home):
    """The registered ``shipd`` marketplace's ``installLocation``, or
    ``None`` when ``known_marketplaces.json`` is missing, unparseable, or
    carries no ``shipd`` entry naming one."""
    path = plugins_home / "known_marketplaces.json"
    try:
        with open(path, encoding="utf-8") as fh:
            data = json.load(fh)
    except (OSError, ValueError):
        return None
    entry = data.get(CLAUDE_MARKETPLACE) if isinstance(data, dict) else None
    location = (entry.get("installLocation")
                if isinstance(entry, dict) else None)
    return location if isinstance(location, str) and location else None


def marketplace_version(location):
    """The version the ``shipd`` marketplace's own copy of the plugin
    manifest declares: ``location``'s marketplace manifest's ``s`` entry,
    followed through its relative-path ``source`` to that copy's own
    ``plugin.json``. Raises :class:`UpdateError` naming the reason wherever a
    manifest is missing, unparseable, or malformed."""
    manifest_path = os.path.join(location, ".claude-plugin",
                                  "marketplace.json")
    try:
        with open(manifest_path, encoding="utf-8") as fh:
            manifest = json.load(fh)
    except OSError as exc:
        raise UpdateError("cannot read %s: %s" % (manifest_path, exc))
    except ValueError as exc:
        raise UpdateError("cannot parse %s: %s" % (manifest_path, exc))
    entries = manifest.get("plugins") if isinstance(manifest, dict) else None
    entry = next((e for e in entries or []
                  if isinstance(e, dict)
                  and e.get("name") == CLAUDE_PLUGIN_NAME), None)
    if entry is None:
        raise UpdateError("%s declares no `%s` plugin entry"
                           % (manifest_path, CLAUDE_PLUGIN_NAME))
    source = entry.get("source")
    if (not isinstance(source, str) or not source
            or os.path.isabs(source) or "://" in source):
        raise UpdateError("%s's `%s` entry has no relative-path `source`"
                           % (manifest_path, CLAUDE_PLUGIN_NAME))
    plugin_manifest_path = os.path.join(location, source, ".claude-plugin",
                                         "plugin.json")
    try:
        with open(plugin_manifest_path, encoding="utf-8") as fh:
            plugin_manifest = json.load(fh)
    except OSError as exc:
        raise UpdateError("cannot read %s: %s" % (plugin_manifest_path, exc))
    except ValueError as exc:
        raise UpdateError("cannot parse %s: %s" % (plugin_manifest_path, exc))
    version = (plugin_manifest.get("version")
               if isinstance(plugin_manifest, dict) else None)
    if not isinstance(version, str) or not version:
        raise UpdateError("%s declares no `version`" % plugin_manifest_path)
    return version


def _claude_run(args, timeout=None):
    """``(returncode, stdout, stderr)`` for ``claude <args...>`` — the single
    subprocess seam :func:`cmd_update` runs through, mirroring
    :func:`_gh_run`, so tests stub it instead of shelling out. A timeout or a
    ``claude`` missing from PATH both read as an ordinary nonzero result."""
    try:
        proc = subprocess.run(["claude"] + list(args), capture_output=True,
                              text=True, timeout=timeout)
    except subprocess.TimeoutExpired:
        return (1, "", "claude timed out after %ss" % timeout)
    except OSError as exc:
        return (1, "", str(exc))
    return (proc.returncode, proc.stdout, proc.stderr)


def cmd_update(args):
    """Report whether a newer plugin version is published and, unless
    ``--check`` is given, install it through the ``claude`` CLI.

    In-binary like ``doctor`` / ``install``: it drives subprocesses and
    prints its own report, so it must not replace this process.
    """
    parser = argparse.ArgumentParser(
        prog="shipd update",
        description="Report whether a newer shipd plugin version is "
                    "published and, unless --check is given, install it.")
    parser.add_argument(
        "--check", action="store_true",
        help="report only; install nothing")
    opts = parser.parse_args(args)

    try:
        if shutil.which("claude") is None:
            raise UpdateError(
                "`claude` is not on PATH — install the Claude Code CLI, "
                "then re-run")

        plugins_home = _plugins_home()
        location = marketplace_location(plugins_home)
        if location is None:
            raise UpdateError(
                "the `%s` marketplace is not registered — run `claude "
                "plugin marketplace add shipd-now/shipd`" % CLAUDE_MARKETPLACE)

        rc, _out, err = _claude_run(
            ["plugin", "marketplace", "update", CLAUDE_MARKETPLACE],
            timeout=MARKETPLACE_TIMEOUT)
        if rc != 0:
            raise UpdateError(
                "cannot refresh the `%s` marketplace: %s"
                % (CLAUDE_MARKETPLACE, (err or "").strip() or
                   "exit %d" % rc))

        available = marketplace_version(location)

        cache_root = _cache_root()
        installed = newest_installed(cache_root)
        if installed is None:
            raise UpdateError(
                "no installed shipd plugin snapshot under %s — run `claude "
                "plugin install %s`" % (cache_root, CLAUDE_PLUGIN_ID))

        if _version_key(available) <= _version_key(installed):
            print("up to date — %s is the newest published version"
                  % installed)
            return 0

        if opts.check:
            print("update available: %s -> %s — run `shipd update` to "
                  "apply" % (installed, available))
            return 0

        print("updating %s: %s -> %s" % (CLAUDE_PLUGIN_ID, installed,
                                          available))
        sys.stdout.flush()
        rc, out, err = _claude_run(["plugin", "update", CLAUDE_PLUGIN_ID])
        if out:
            sys.stdout.write(out)
        if rc != 0:
            raise UpdateError(
                "cannot update %s: %s"
                % (CLAUDE_PLUGIN_ID, (err or "").strip() or
                   "exit %d" % rc))

        newest = newest_installed(cache_root)
        print("updated to %s — start a new session to load it" % newest)
        return 0
    except UpdateError as exc:
        _err(str(exc))
        return 1


def main(argv):
    if not argv:
        sys.stderr.write(USAGE)
        return 2
    verb, rest = argv[0], argv[1:]
    if verb in ("help", "-h", "--help"):
        sys.stdout.write(USAGE)
        return 0
    if verb == "--version":
        return cmd_version()
    if verb == "list":
        return cmd_list(rest)
    if verb == "doctor":
        return cmd_doctor(rest)
    if verb == "statusline":
        return cmd_statusline(rest)
    if verb == "copilot":
        return cmd_copilot(rest)
    if verb == "vendor":
        return cmd_vendor(rest)
    if verb == "harness":
        return cmd_harness(rest)
    if verb == "install":
        return cmd_install(rest)
    if verb == "update":
        return cmd_update(rest)
    if verb not in VERB_TABLE:
        sys.stderr.write(USAGE)
        return 2

    script, leading = VERB_TABLE[verb]
    # Bare `shipd metrics` means the delivery-metrics summary; metrics.py has
    # no default subcommand of its own.
    if verb == "metrics" and not rest:
        leading = ["summary"]
    # `shipd board [mode]` picks its renderer by mode word, consuming it; any
    # other first argument (or none) leaves the default mode in place.
    if verb == "board":
        mode = rest[0] if rest and rest[0] in BOARD_MODES else None
        if mode is not None:
            rest = rest[1:]
        script, leading = BOARD_MODES[mode]
    command = [sys.executable, str(SCRIPTS / script), *leading, *rest]
    try:
        os.execv(sys.executable, command)
    except OSError as exc:
        _err("cannot run %s: %s" % (script, exc))
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
