#!/usr/bin/env python3
"""shipd — the single command-line front end for the shipd spec engine.

A curated dispatcher, not a passthrough: every verb below maps to one engine
script invocation under ``../skills/build/scripts/``, resolved relative to this
file's own resolved location so the binary works from a repo checkout and from
a versioned plugin cache snapshot alike. Delegation is process replacement
(:func:`os.execv`), so the delegate's stdout, stderr, interactivity, and exit
code are this binary's own — nothing is reimplemented or reformatted here.

Only read/inspect verbs are exposed. The mutating verbs (``set-status``,
``merge``, ``emit``, ``autopilot``, ``worktree remove``) stay behind their
guarded scripts and skills.

Stdlib-only Python 3, per the engine's constitution.
"""

import argparse
import importlib.util
import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
PLUGIN_ROOT = HERE.parent
SCRIPTS = PLUGIN_ROOT / "skills" / "build" / "scripts"
MANIFEST = PLUGIN_ROOT / ".claude-plugin" / "plugin.json"

# An applied change is archived as ``completed/<YYYY-MM-DD>-<slug>/``; the slug
# is the change's name. Mirrors the engine's own archive-directory convention
# (``metrics.py``'s ship-date walk, ``dashboard.py``'s ``completed/*-<slug>``
# resolution) rather than importing a private helper.
ARCHIVE_DIR_RE = re.compile(r"^\d{4}-\d{2}-\d{2}-(.+)$")

# The engine modules the in-binary ``list`` verb reads, imported on demand by
# :func:`_load_engine` — every other verb replaces this process before it needs
# them, so dispatch pays no import cost.
sc = None
ss = None

# The curated verb table: verb -> (engine script, leading arguments). Trailing
# arguments from the command line are appended verbatim, so ``--root``, slugs,
# and flags keep working exactly as they do against the script itself.
VERB_TABLE = {
    "status": ("spec_status.py", ["show"]),
    "locate": ("spec_status.py", ["locate"]),
    "epic": ("spec_status.py", ["epic-show"]),
    "workspace": ("spec_status.py", ["workspace-show"]),
    "board": ("dashboard.py", ["tui"]),
    "metrics": ("metrics.py", []),
    "lint": ("spec_lint.py", []),
}

# ``board`` leads with the interactive board and exposes its other renderings
# as positional mode words: mode -> (engine script, leading arguments), with
# ``None`` the mode-less default. A mode is recognized only when it is the
# *first* trailing argument and a bare word, so ``shipd board --root X`` keeps
# the default mode and passes its flags through untouched.
BOARD_MODES = {
    None: ("dashboard.py", ["tui"]),
    "text": ("dashboard.py", ["board"]),
}

USAGE = """\
usage: shipd <verb> [args...]

Read/inspect verbs over the shipd spec engine. Trailing arguments are passed
through to the engine verbatim.

verbs:
  list [--root DIR] [--all]  in-flight changes across the root and its worktrees
  status [change]            a change's status and progress
  locate [change]            where an installed change lives
  epic <slug>                an epic's status, metadata, and member states
  workspace                  the workspace root, its projects, and initiatives
  board [text] [args]        the delivery board (default: full-screen)
  metrics [subverb]          delivery metrics (default: summary)
  lint [change]              structurally validate specs and change deltas
  doctor                     preflight this environment for shipd

options:
  -h, --help                 print this banner
  --version                  print the plugin version

The read verbs list, status, locate, epic, workspace, and lint accept --json,
emitting one machine-readable JSON document instead of the text report.
"""


def _err(reason):
    """Write the convention's single ``Error: <reason>`` line to stderr, red
    prefix only on a terminal with ``NO_COLOR`` unset.

    The engine's ``cli_common.err`` is the authority on this format; the guard
    is inlined here because dispatch replaces this process (:func:`os.execv`)
    before any engine import, and a path insert plus import on every invocation
    is not worth two error sites. Keep the two in step.
    """
    prefix = "Error:"
    if sys.stderr.isatty() and not os.environ.get("NO_COLOR"):
        prefix = "\x1b[31m%s\x1b[0m" % prefix
    sys.stderr.write("%s %s\n" % (prefix, reason))


def cmd_version():
    """Print the version the adjacent plugin manifest declares — the shipping
    unit's own version, so a checkout copy and a cache snapshot each report
    what they actually are."""
    try:
        with open(MANIFEST, encoding="utf-8") as fh:
            data = json.load(fh)
        version = data["version"]
    except (OSError, ValueError, KeyError, TypeError) as exc:
        _err("cannot read %s: %s" % (MANIFEST, exc))
        return 1
    print(version)
    return 0


def _load_engine():
    """Import ``spec_common`` and ``spec_status`` from the engine's scripts dir
    into the module globals ``sc``/``ss``. Deferred to the ``list`` path so a
    delegating verb never pays for it."""
    global sc, ss
    if str(SCRIPTS) not in sys.path:
        sys.path.insert(0, str(SCRIPTS))
    import spec_common
    import spec_status
    sc = spec_common
    ss = spec_status


def _content_dir(root):
    """``root``'s content directory as its layered config resolves it, or
    ``None`` when that config is unusable — a foreign directory under
    ``.worktrees/`` must never fail the listing."""
    try:
        return sc.specs_dir(root)
    except sc.ConfigError:
        return None


def _subdirs(path):
    """Sorted directory entries under ``path`` that are themselves
    directories; empty when ``path`` is missing or unreadable."""
    try:
        names = sorted(os.listdir(path))
    except OSError:
        return []
    return [n for n in names if os.path.isdir(os.path.join(path, n))]


def _planned_rows(root, location):
    """``(name, location, status)`` for every change under ``root``'s
    ``planned/``, status read by the engine (``?`` when missing or invalid,
    as ``spec_status.py locate`` prints it)."""
    content = _content_dir(root)
    if content is None:
        return []
    return [(name, location, ss.read_status(root, name) or "?")
            for name in _subdirs(os.path.join(content, "planned"))]


def _archived_rows(root, location):
    """``(name, location, "archived")`` for every applied change under
    ``root``'s ``completed/``, named by the archive directory's slug."""
    content = _content_dir(root)
    if content is None:
        return []
    rows = []
    for name in _subdirs(os.path.join(content, "completed")):
        m = ARCHIVE_DIR_RE.match(name)
        rows.append((m.group(1) if m else name, location, "archived"))
    return rows


def _probes(root):
    """``(directory, location-label)`` pairs to probe, the invocation root
    first and then each ``.worktrees/<name>`` in sorted order — the probe
    order and precedence of ``spec_status.py locate``."""
    probes = [(root, "root")]
    worktrees = os.path.join(root, ".worktrees")
    for name in _subdirs(worktrees):
        probes.append((os.path.join(worktrees, name), "worktree:" + name))
    return probes


def _collect(root, reader):
    """Apply ``reader`` over every probe, keyed by change name. Probes run
    root-first, so a worktree occurrence wins a contested name."""
    found = {}
    for candidate, location in _probes(root):
        for row in reader(candidate, location):
            found[row[0]] = row
    return found


def cmd_list(args):
    """List in-flight changes across the invocation root and its worktrees."""
    parser = argparse.ArgumentParser(
        prog="shipd list",
        description="In-flight changes across the root and its worktrees.")
    parser.add_argument("--root", default=os.getcwd(),
                        help="repository root (default: cwd)")
    parser.add_argument("--all", action="store_true",
                        help="also list applied changes from completed/")
    parser.add_argument("--json", action="store_true", dest="json",
                        help="emit the rows as a JSON array on stdout")
    opts = parser.parse_args(args)
    root = os.path.abspath(opts.root)
    _load_engine()

    in_flight = _collect(root, _planned_rows)
    rows = [in_flight[name] for name in sorted(in_flight)]
    if opts.all:
        # Appended after the in-flight rows; a name still in flight keeps its
        # live row rather than an older archive of the same change.
        archived = _collect(root, _archived_rows)
        rows.extend(archived[name] for name in sorted(archived)
                    if name not in in_flight)

    # The machine rendering of the very same rows, in the very same order — an
    # empty listing is an empty array, never the text placeholder (shipd-cli
    # list-json).
    if opts.json:
        print(json.dumps([{"name": name, "location": location,
                           "status": status}
                          for name, location, status in rows]))
        return 0

    if not rows:
        print("no changes in flight")
        return 0
    name_width = max(len(row[0]) for row in rows)
    location_width = max(len(row[1]) for row in rows)
    for name, location, status in rows:
        print("%-*s  %-*s  %s"
              % (name_width, name, location_width, location, status))
    return 0


# ---------------------------------------------------------------------------
# doctor (shipd-cli doctor-verb)
# ---------------------------------------------------------------------------

# The interpreter floor: the engine is stdlib-only Python 3 and the pinned
# ``textual`` supports 3.9+, so 3.9 is the oldest interpreter the whole surface
# runs on.
PYTHON_FLOOR = (3, 9)

# A plugin cache snapshot lives at ``<cache>/<marketplace>/<plugin>/<version>/``
# — a directory named for a dotted release. A checkout's ``plugins/s`` never is.
VERSION_DIR_RE = re.compile(r"^\d+(?:\.\d+)*$")


def _version_key(name):
    """A dotted version's comparison key, so ``0.6.10`` sorts above ``0.6.9``
    where a plain string sort would not."""
    return tuple(int(part) for part in name.split("."))


def _gh_auth_status():
    """The exit code of ``gh auth status``; nonzero when gh cannot be run at
    all. The one subprocess in the doctor path, isolated here so tests inject
    a stub instead of touching the network."""
    try:
        return subprocess.run(["gh", "auth", "status"],
                              capture_output=True).returncode
    except OSError:
        return 1


def check_python(version_info=None):
    """The running interpreter — the one the engine itself runs on."""
    info = tuple((version_info or sys.version_info)[:3])
    shown = ".".join(str(part) for part in info)
    floor = ".".join(str(part) for part in PYTHON_FLOOR)
    if info >= PYTHON_FLOOR:
        return ("ok", "python", "%s (>= %s)" % (shown, floor))
    return ("fail", "python",
            "%s is below the required %s — run shipd on a newer Python 3"
            % (shown, floor))


def check_git(which=shutil.which):
    """git — every worktree, branch, and PR in the workflow needs it."""
    found = which("git")
    if found:
        return ("ok", "git", "found at %s" % found)
    return ("fail", "git",
            "not on PATH — install git (https://git-scm.com/downloads); "
            "worktrees, branches, and shipping all need it")


def check_config(root):
    """The layered content-directory configuration at ``root``. A missing
    content directory is fine — ``/s:plan`` scaffolds it on first use; only an
    unusable config file is a failure."""
    _load_engine()
    try:
        content = sc.specs_dir(root)
    except sc.ConfigError as exc:
        return ("fail", "config", "%s" % exc)
    if os.path.isdir(content):
        return ("ok", "config", "content directory %s" % content)
    return ("ok", "config",
            "no content directory yet at %s — /s:plan scaffolds it" % content)


def check_gh(which=shutil.which, gh_status=_gh_auth_status):
    """The GitHub CLI. A warning, never a failure: planning and building work
    without it, and shipping is its first touchpoint."""
    found = which("gh")
    if not found:
        return ("warn", "gh",
                "not on PATH — needed only to ship (https://cli.github.com)")
    if gh_status() != 0:
        return ("warn", "gh",
                "%s is not authenticated — run `gh auth login` before shipping"
                % found)
    return ("ok", "gh", "authenticated at %s" % found)


def check_textual(find_spec=importlib.util.find_spec):
    """The delivery board's one third-party dependency — board-only, so its
    absence is a warning."""
    try:
        found = find_spec("textual") is not None
    except (ImportError, ValueError):
        found = False
    if found:
        return ("ok", "textual", "importable; the delivery board can render")
    return ("warn", "textual",
            "not importable — only the board (`shipd board`) needs it; "
            "pip install -r requirements.txt")


def check_snapshot(plugin_root):
    """Whether this binary is the newest installed plugin snapshot.

    ``plugin_root`` is the directory holding this ``bin/`` — a version-named
    directory inside a plugin cache, or a repository checkout's ``plugins/s``.
    """
    root = Path(plugin_root)
    if not VERSION_DIR_RE.match(root.name):
        return ("ok", "snapshot", "dev mode — running from %s" % root)
    versions = [name for name in _subdirs(str(root.parent))
                if VERSION_DIR_RE.match(name)]
    newest = max(versions, key=_version_key) if versions else root.name
    if _version_key(newest) > _version_key(root.name):
        return ("warn", "snapshot",
                "running %s but %s is installed — start a new session to load "
                "it" % (root.name, newest))
    return ("ok", "snapshot", "%s is the newest installed snapshot" % newest)


def default_checks(root):
    """Every preflight check, required ones first, as ``(level, name, detail)``
    triples."""
    return [check_python(),
            check_git(),
            check_config(root),
            check_gh(),
            check_textual(),
            check_snapshot(PLUGIN_ROOT)]


def doctor_report(results):
    """``(lines, exit_code)`` for a sequence of check results: one
    ``<level> <check> — <detail>`` line each, a closing summary, and exit ``1``
    iff a check failed — a warning reports but never fails the preflight."""
    lines = ["%s %s — %s" % result for result in results]
    problems = [level for level, _name, _detail in results if level != "ok"]
    failed = any(level == "fail" for level, _name, _detail in results)
    lines.append("doctor: %d problem(s)" % len(problems) if problems
                 else "doctor: ok")
    return lines, 1 if failed else 0


def cmd_doctor(args):
    """Preflight the environment. Read-only: nothing here installs or edits."""
    parser = argparse.ArgumentParser(
        prog="shipd doctor",
        description="Preflight the environment shipd runs in. Reports only.")
    parser.parse_args(args)
    lines, code = doctor_report(default_checks(os.getcwd()))
    for line in lines:
        print(line)
    return code


def main(argv):
    if not argv:
        sys.stderr.write(USAGE)
        return 2
    verb, rest = argv[0], argv[1:]
    if verb in ("help", "-h", "--help"):
        sys.stdout.write(USAGE)
        return 0
    if verb == "--version":
        return cmd_version()
    if verb == "list":
        return cmd_list(rest)
    if verb == "doctor":
        return cmd_doctor(rest)
    if verb not in VERB_TABLE:
        sys.stderr.write(USAGE)
        return 2

    script, leading = VERB_TABLE[verb]
    # Bare `shipd metrics` means the delivery-metrics summary; metrics.py has
    # no default subcommand of its own.
    if verb == "metrics" and not rest:
        leading = ["summary"]
    # `shipd board [mode]` picks its renderer by mode word, consuming it; any
    # other first argument (or none) leaves the default mode in place.
    if verb == "board":
        mode = rest[0] if rest and rest[0] in BOARD_MODES else None
        if mode is not None:
            rest = rest[1:]
        script, leading = BOARD_MODES[mode]
    command = [sys.executable, str(SCRIPTS / script), *leading, *rest]
    try:
        os.execv(sys.executable, command)
    except OSError as exc:
        _err("cannot run %s: %s" % (script, exc))
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
